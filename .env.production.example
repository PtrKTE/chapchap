# ==============================================================
# CHAPCHAP — Configuration Production
# ==============================================================
# Copier ce fichier en .env sur le serveur de production
# et remplir les valeurs marquées "A_REMPLIR"
# ==============================================================

APP_NAME=CHAPCHAP
APP_ENV=production
APP_KEY=A_REMPLIR
APP_DEBUG=false
APP_TIMEZONE=Africa/Abidjan
APP_URL=https://chapchap.votredomaine.ci

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Nombre de workers PHP (ajuster selon le CPU du VPS)
PHP_CLI_SERVER_WORKERS=4

# Bcrypt : 12 rounds en production (sécurité vs performance)
BCRYPT_ROUNDS=12

# --------------------------------------------------------------
# LOGS
# --------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --------------------------------------------------------------
# BASE DE DONNEES (MySQL 8+)
# --------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chapchap
DB_USERNAME=chapchap_user
DB_PASSWORD=A_REMPLIR
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --------------------------------------------------------------
# SESSIONS & CACHE
# --------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=chapchap_

# --------------------------------------------------------------
# MAIL (notifications — optionnel pour S12)
# --------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=A_REMPLIR
MAIL_PORT=587
MAIL_USERNAME=A_REMPLIR
MAIL_PASSWORD=A_REMPLIR
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@chapchap.ci"
MAIL_FROM_NAME="CHAPCHAP"

# --------------------------------------------------------------
# BACKUP (spatie/laravel-backup)
# --------------------------------------------------------------
BACKUP_DISK=local
BACKUP_MAIL_TO=A_REMPLIR

# --------------------------------------------------------------
# VITE (assets compilés en production)
# --------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
